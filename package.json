{
  "name": "backend-tools-dev",
  "displayName": "backend tools Generator",
  "description": "Genera DTOs con Swagger, Repository, Service, Controller y CRUD completo desde entidades TypeORM. Incluye autocompletado inteligente de funciones en controladores.",
  "version": "3.0.0",
  "publisher": "crdsyntax",
  "icon": "images/logo.jpg",
  "repository": {
    "type": "git",
    "url": "https://github.com/crdsyntax/quick-dto"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "nestjs",
    "typeorm",
    "dto",
    "swagger",
    "crud",
    "generator",
    "autocomplete",
    "productivity"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nest-tools-explorer",
          "title": "Entity visualizer",
          "icon": "images/entity.svg"
        },
        {
          "id": "httpTesterContainer",
          "title": "HTTP Tester",
          "icon": "images/socket.svg"
        },
        {
          "id": "dto-properties-panel",
          "title": "DTO Properties",
          "icon": "images/sequence.svg"
        }
      ]
    },
    "views": {
      "nest-tools-explorer": [
        {
          "id": "nest-tools.entityView",
          "name": "Entities",
          "icon": "images/entity.svg"
        }
      ],
      "dto-properties-panel": [
        {
          "id": "nest-tools.dtoPropertiesView",
          "name": "DTO Properties",
          "type": "webview",
          "icon": "images/socket.svg"
        }
      ],
      "socketTesterContainer": [
        {
          "id": "socketTesterView",
          "name": "Socket Tester",
          "type": "webview",
          "icon": "images/socket.svg"
        }
      ],
      "httpTesterContainer": [
        {
          "id": "httpTesterView",
          "name": "HTTP Tester",
          "type": "webview",
          "icon": "images/socket.svg"
        }
      ]
    },
    "assets": [
      "media/*.css"
    ],
    "commands": [
      {
        "command": "nest-dto-generator.generateDto",
        "title": "Generate DTOs (Create + Update)",
        "category": "NestJS CRUD"
      },
      {
        "command": "nest-dto-generator.generateInterface",
        "title": "Generate Interface",
        "category": "NestJS CRUD"
      },
      {
        "command": "nest-dto-generator.generateReturnInterface",
        "title": "Generate Interface from Return",
        "category": "NestJS CRUD"
      },
      {
        "command": "nest-dto-generator.generateRepository",
        "title": "Generate Repository",
        "category": "NestJS CRUD"
      },
      {
        "command": "nest-dto-generator.generateService",
        "title": "Generate Service",
        "category": "NestJS CRUD"
      },
      {
        "command": "nest-dto-generator.generateController",
        "title": "Generate Controller from Service",
        "category": "NestJS CRUD"
      },
      {
        "command": "nest-dto-generator.generateCrud",
        "title": "Generate Full CRUD (DTO + Repo + Service + Controller)",
        "category": "NestJS CRUD"
      },
      {
        "command": "nest-tools.completeReturnType",
        "title": "Complete Return Type (Smart Promise<T>)",
        "category": "NestJS"
      },
      {
        "command": "nest-tools.triggerReturnType",
        "title": "Trigger Complete Return Type",
        "category": "NestJS"
      },
      {
        "command": "nest-tools.controllerByFunction",
        "title": "Generate Controller Endpoint",
        "category": "NestJS"
      },
      {
        "command": "nest-tools.generateDiagram",
        "title": "Generate diagram",
        "category": "NestJS"
      },
      {
        "command": "nest-tools.generateEntity",
        "title": "Generate Entity",
        "category": "NestJS"
      },
      {
        "command": "nest-tools.generateEntityFromPalette",
        "title": "NestJS: Generate Entity",
        "category": "NestJS"
      },
      {
        "command": "nest-tools.convertOrm",
        "title": "NestJS: Convert ORM (TypeORM ↔ Mongoose)",
        "category": "NestJS"
      },
      {
        "command": "nest-tools.migrateToTypeOrm",
        "title": "NestJS: Migrate Mongoose to TypeORM",
        "category": "NestJS"
      },
      {
        "command": "nest-tools.generateErd",
        "title": "NestJS: Generate ER Diagram",
        "category": "NestJS"
      },
      {
        "command": "nest-tools.viewEntityErd",
        "title": "View ER Diagram",
        "category": "NestJS",
        "icon": "$(graph)"
      },
      {
        "command": "nest-tools.searchEntities",
        "title": "Search Entities",
        "category": "NestJS",
        "icon": "$(search)"
      },
      {
        "command": "nest-tools.clearSearchEntities",
        "title": "Clear Search",
        "category": "NestJS",
        "icon": "$(clear-all)"
      },
      {
        "command": "socketTester.connect",
        "title": "Socket.IO Tester",
        "category": "Development"
      },
      {
        "command": "nest-tools.addLoggerDebug",
        "title": "Add Logger Debug Statement",
        "category": "Debug"
      },
      {
        "command": "nest-tools.openHttpTester",
        "title": "NestJS: Open HTTP Tester"
      },
      {
        "command": "nest-tools.closeHttpTester",
        "title": "NestJS: Close HTTP Tester"
      },
      {
        "command": "nest-tools.generateHttpCollections",
        "title": "NestJS Tools: Generar Colecciones HTTP (Controller)"
      },
      {
        "command": "nest-tools.openHttpTester",
        "title": "API Tester: Open",
        "category": "NestJS Tools"
      },
      {
        "command": "nest-tools.openHttpTesterNewTab",
        "title": "API Tester: New Tab",
        "category": "NestJS Tools"
      },
      {
        "command": "nest-tools.closeAllHttpTesterTabs",
        "title": "API Tester: Close All Tabs",
        "category": "NestJS Tools"
      },
      {
        "command": "nest-tools.showHttpTesterInfo",
        "title": "API Tester: Show Info",
        "category": "NestJS Tools"
      },
      {
        "command": "nest-tools.focusHttpTester",
        "title": "API Tester: Focus",
        "category": "NestJS Tools"
      },
      {
        "command": "nest-tools.enableAutoCommit",
        "title": "Enable Auto-Commit",
        "category": "Git"
      },
      {
        "command": "nest-tools.disableAutoCommit",
        "title": "Disable Auto-Commit",
        "category": "Git"
      },
      {
        "command": "nest-tools.toggleAutoCommit",
        "title": "Toggle Auto-Commit",
        "category": "Git"
      },
      {
        "command": "extension.createProject",
        "title": "Crear Proyecto...",
        "category": "Project Tools"
      },
      {
        "command": "nest-tools.openFlowchartEditor",
        "title": "Open Flowchart Editor",
        "category": "NestJS Tools",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "nest-tools.renderSelectedAsFlowchart",
        "title": "Render Selected Entities as Flowchart",
        "category": "NestJS Tools",
        "icon": "$(type-hierarchy-sub)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "nest-tools.viewEntityErd",
          "when": "view == nest-tools.entityView && viewItem == entityItem",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "nest-tools.renderSelectedAsFlowchart",
          "when": "view == nest-tools.entityView",
          "group": "navigation@1"
        },
        {
          "command": "nest-tools.searchEntities",
          "when": "view == nest-tools.entityView",
          "group": "navigation@2"
        },
        {
          "command": "nest-tools.clearSearchEntities",
          "when": "view == nest-tools.entityView",
          "group": "navigation@3"
        },
        {
          "command": "extension.createProject",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "nest-tools.generateHttpCollections",
          "group": "nest-tools@1",
          "when": "resourceExtname == .ts && resourceFilename =~ /controller\\.ts$/"
        },
        {
          "command": "nest-dto-generator.generateDto",
          "when": "resourceFilename =~ /\\.entity|schema\\.ts$/",
          "group": "nestjs@1"
        },
        {
          "command": "nest-dto-generator.generateInterface",
          "when": "resourceFilename =~ /\\.entity|schema\\.ts$/",
          "group": "nestjs@1"
        },
        {
          "command": "nest-dto-generator.generateCrud",
          "when": "resourceFilename =~ /\\.(entity|schema)\\.ts$/",
          "group": "nestjs@2"
        },
        {
          "command": "nest-dto-generator.generateRepository",
          "when": "resourceFilename =~ /\\.(entity|schema)\\.ts$/",
          "group": "nestjs@3"
        },
        {
          "command": "nest-dto-generator.generateService",
          "when": "resourceFilename =~ /\\.(entity|schema)\\.ts$/",
          "group": "nestjs@4"
        },
        {
          "command": "nest-dto-generator.generateController",
          "when": "resourceFilename =~ /\\.(entity|service|schema)\\.ts$/",
          "group": "nestjs@5"
        },
        {
          "command": "nest-tools.generateDiagram",
          "when": "resourceFilename =~ /\\.entity\\.ts$/",
          "group": "nestjs@5"
        },
        {
          "command": "nest-tools.generateEntity",
          "when": "explorerResourceIsFolder",
          "group": "nestjs@6"
        },
        {
          "command": "nest-tools.convertOrm",
          "when": "resourceExtname == .ts",
          "group": "nestjs@7"
        },
        {
          "command": "nest-tools.generateErd",
          "when": "resourceFilename =~ /\\.entity\\.ts$/",
          "group": "nestjs@8"
        },
        {
          "command": "nest-tools.generateHttpCollections",
          "group": "NestJS Tools",
          "when": "resourceLangId == 'typescript'"
        },
        {
          "command": "extension.createProject",
          "group": "navigation",
          "when": "explorerViewletVisible && !inputFocus"
        },
        {
          "command": "extension.createProject",
          "group": "navigation",
          "when": "explorerResourceIsFolder"
        }
      ],
      "editor/context": [
        {
          "command": "nest-tools.generateHttpCollections",
          "group": "nest-tools@1",
          "when": "resourceExtname == .ts && resourceFilename =~ /controller\\.ts$/"
        },
        {
          "command": "nest-tools.openHttpTester",
          "when": "resourceLangId == typescript",
          "group": "navigation"
        },
        {
          "command": "nest-tools.completeReturnType",
          "when": "editorTextFocus && editorLangId == typescript",
          "group": "modification"
        },
        {
          "command": "nest-tools.controllerByFunction",
          "when": "editorHasSelection && editorLangId == typescript",
          "group": "modification"
        },
        {
          "command": "nest-dto-generator.generateReturnInterface",
          "when": "editorTextFocus && editorLangId == typescript",
          "group": "modification"
        },
        {
          "command": "nest-tools.addLoggerDebug",
          "when": "editorHasSelection",
          "group": "modification"
        },
        {
          "command": "nest-tools.openHttpTesterNewTab",
          "group": "navigation",
          "when": "editorTextFocus"
        },
        {
          "command": "nest-tools.openHttpTester",
          "group": "navigation",
          "when": "editorTextFocus"
        }
      ],
      "command-palette": [
        {
          "command": "nest-tools.generateEntityFromPalette"
        },
        {
          "command": "nest-tools.openFlowchartEditor"
        },
        {
          "command": "nest-tools.convertOrm"
        },
        {
          "command": "nest-tools.migrateToTypeOrm"
        },
        {
          "command": "nest-tools.openHttpTester",
          "when": "true"
        },
        {
          "command": "nest-tools.openHttpTesterNewTab",
          "when": "always"
        },
        {
          "command": "nest-tools.closeAllHttpTesterTabs",
          "when": "always"
        },
        {
          "command": "nest-tools.showHttpTesterInfo",
          "when": "always"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "explorer",
        "contents": "No tienes un proyecto activo.\n[Crear Nuevo Proyecto](command:extension.createProject)"
      }
    ],
    "keybindings": [
      {
        "command": "nest-tools.completeReturnType",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorTextFocus"
      },
      {
        "command": "nest-tools.addLoggerDebug",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+t",
        "when": "editorTextFocus"
      },
      {
        "command": "nest-tools.controllerByFunction",
        "key": "ctrl+shift+y",
        "mac": "cmd+shift+t",
        "when": "editorTextFocus"
      },
      {
        "command": "nest-tools.toggleAutoCommit",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile -- --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.27.0",
    "vsce": "^2.15.0",
    "@types/bun": "latest"
  },
  "dependencies": {
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "axios": "^1.13.2",
    "form-data": "^4.0.5",
    "mermaid": "^11.12.1",
    "readline": "^1.3.0",
    "socket.io-client": "^4.8.1",
    "ts-morph": "^27.0.2",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "typescript": "^5.3.0"
  },
  "private": true,
  "peerDependencies": {
    "typescript": "^5"
  }
}